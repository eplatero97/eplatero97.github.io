---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'A Deep Learning Implementation Blog' } = Astro.props;
const siteTitle = 'Decoding Intelligence';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title === siteTitle ? title : `${title} | ${siteTitle}`}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav-inner">
        <a href="/" class="site-title">Decoding Intelligence</a>
        <ul class="nav-links">
          <li><a href="/">Posts</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>© {new Date().getFullYear()} Erick Platero</p>
    </footer>
  </body>
</html>

<style is:global>
  @import '/src/styles/global.css';
</style>

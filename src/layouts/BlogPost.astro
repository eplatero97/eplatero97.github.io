---
import Base from './Base.astro';

interface Props {
  title: string;
  pubDate: Date;
  description?: string;
  category?: string;
  tags?: string[];
}

const { title, pubDate, description, category, tags = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---
<Base title={title} description={description}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {category && <span>·</span>}
        {category && <span>{category}</span>}
        {tags.length > 0 && (
          <div class="tags">
            {tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        )}
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Base title="Decoding Intelligence" description="A Deep Learning Implementation Blog by Erick Platero — ASIC Engineer at Qualcomm.">
  <div class="home-intro">
    <h1 class="page-heading">Decoding Intelligence</h1>
    <p>
      Writing on deep learning, AI, and software by <a href="/about">Erick Platero</a> —
      ASIC Engineer at Qualcomm working on LLM inference.
    </p>
  </div>

  <h2 class="posts-heading">Posts</h2>
  <ul class="post-list">
    {posts.map(post => (
      <li class="post-card">
        <div class="post-card-body">
          <div class="post-card-meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
            </time>
            {post.data.category && <span>·</span>}
            {post.data.category && <span>{post.data.category}</span>}
          </div>
          <h3><a href={`/blog/${post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a></h3>
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="tags">
              {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
          )}
        </div>
        {post.data.cover && (
          <img src={post.data.cover} alt="" class="post-card-thumb" aria-hidden="true" />
        )}
      </li>
    ))}
  </ul>
</Base>

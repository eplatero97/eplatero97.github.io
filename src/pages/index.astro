---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Base title="Decoding Intelligence" description="A Deep Learning Implementation Blog">
  <h1 class="page-heading">Posts</h1>
  <ul class="post-list">
    {posts.map(post => (
      <li class="post-card">
        <div class="post-card-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
          </time>
          {post.data.category && <span>·</span>}
          {post.data.category && <span>{post.data.category}</span>}
        </div>
        <h2><a href={`/blog/${post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a></h2>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="tags">
            {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        )}
      </li>
    ))}
  </ul>
</Base>
